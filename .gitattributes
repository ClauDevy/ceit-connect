# Keep all detected text files LF in both the repository and working tree.
* text=auto eol=lf

# Project text formats.
*.sql         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.css         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.html        text eol=lf
*.svg         text eol=lf
*.xml         text eol=lf
*.txt         text eol=lf
*.toml        text eol=lf
*.sh          text eol=lf
*.ps1         text eol=lf
*.example     text eol=lf
*.tsbuildinfo text eol=lf
.gitignore    text eol=lf

# Binary images and icons.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.bmp  binary
*.tif  binary
*.tiff binary
*.ico  binary

# Binary fonts.
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# Archives and other binary documents/media.
*.zip  binary
*.gz   binary
*.tgz  binary
*.7z   binary
*.rar  binary
*.pdf  binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.mp4  binary
*.webm binary
